# MAG (MyAnimeGW) Centralized Anime API Backend configuration
NEXT_PUBLIC_ANIME_API=https://www.sankavollerei.web.id/anime

# Fetch gateway used when an upstream host (Sanka API / otakudesu.blog)
# Cloudflare-blocks the server's datacenter IP (e.g. on Vercel).
# URL template containing {url}; the encoded target URL replaces it.
# Default when unset: https://api.allorigins.win/raw?url={url}
#   - Free, no key, but flaky (can return 500/522 under load).
# For stable streaming use a bypass-capable service, e.g.:
#   FETCH_GATEWAY=https://api.scraperapi.com?api_key=YOUR_KEY&url={url}
# Or self-host a gateway and point the template at it.
# Set to "off" to disable the gateway and only fetch directly.
FETCH_GATEWAY=https://api.allorigins.win/raw?url={url}
